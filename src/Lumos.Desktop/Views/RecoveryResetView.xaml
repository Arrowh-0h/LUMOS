<UserControl x:Class="Lumos.Desktop.Views.RecoveryResetView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:Lumos.Desktop.Views"
             xmlns:conv="clr-namespace:Lumos.Desktop.Converters">
    <UserControl.Resources>
        <conv:StringToVisibilityConverter x:Key="StringToVisibility"/>
        <conv:StrengthScoreToBrushConverter x:Key="ScoreToBrush"/>
    </UserControl.Resources>

    <Grid>
        <views:CyberBackdrop/>

        <StackPanel VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Width="540">

            <TextBlock Text="LUMOS"
                       Style="{StaticResource DisplayHeading}"
                       FontSize="{StaticResource FontSize3xl}"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,4">
                <TextBlock.Effect>
                    <DropShadowEffect Color="{StaticResource AccentGoldShadowColor}"
                                      BlurRadius="16" ShadowDepth="0" Opacity="0.45"/>
                </TextBlock.Effect>
            </TextBlock>

            <TextBlock Text="// the other way in"
                       Style="{StaticResource MonoLabel}"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,28"/>

            <ContentControl Style="{StaticResource NeonCard}">
                <StackPanel Margin="32,28">
                    <TextBlock Text="// RECOVER"
                               Style="{StaticResource MonoLabel}"
                               Margin="0,0,0,4"/>
                    <TextBlock Text="Reset your master password"
                               Style="{StaticResource SectionHeading}"
                               Margin="0,0,0,6"/>
                    <TextBlock Style="{StaticResource SecondaryText}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,20"
                               Text="Enter the recovery code you saved when you set up this vault, then choose a new master password. Your entries are not re-encrypted and nothing is lost."/>

                    <TextBlock Text="RECOVERY CODE" Style="{StaticResource MonoLabel}" Margin="0,0,0,6"/>
                    <TextBox Style="{StaticResource LumosTextBox}"
                             FontFamily="{StaticResource MonoFontFamily}"
                             Margin="0,0,0,4"
                             Text="{Binding RecoveryCodeText, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Style="{StaticResource SecondaryText}"
                               FontFamily="{StaticResource MonoFontFamily}"
                               FontSize="11"
                               Margin="0,0,0,16"
                               Text="{Binding CodeHint}"
                               Visibility="{Binding CodeHint, Converter={StaticResource StringToVisibility}}"/>

                    <TextBlock Text="NEW MASTER PASSWORD" Style="{StaticResource MonoLabel}" Margin="0,0,0,6"/>
                    <views:RevealPasswordBox x:Name="PasswordField"
                                             PasswordChanged="PasswordField_PasswordChanged"
                                             Margin="0,0,0,12"/>

                    <Grid Margin="0,0,0,4">
                        <Border Background="{StaticResource BorderBrush}" Height="3"/>
                        <Border x:Name="StrengthBar"
                                Background="{Binding StrengthScore, Converter={StaticResource ScoreToBrush}}"
                                Height="3"
                                HorizontalAlignment="Left"
                                Width="0">
                            <Border.RenderTransform>
                                <ScaleTransform ScaleX="1" CenterX="0"/>
                            </Border.RenderTransform>
                        </Border>
                    </Grid>
                    <TextBlock Style="{StaticResource SecondaryText}"
                               Margin="0,4,0,12"
                               FontFamily="{StaticResource MonoFontFamily}"
                               FontSize="11"
                               Text="{Binding StrengthLabel}"
                               Foreground="{Binding StrengthScore, Converter={StaticResource ScoreToBrush}}"/>

                    <TextBlock Text="CONFIRM" Style="{StaticResource MonoLabel}" Margin="0,0,0,6"/>
                    <views:RevealPasswordBox x:Name="ConfirmField"
                                             Margin="0,0,0,8"
                                             PasswordKeyDown="ConfirmField_KeyDown"/>

                    <TextBlock Style="{StaticResource SecondaryText}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,16"
                               Text="{Binding HintMessage}"
                               Visibility="{Binding HintMessage, Converter={StaticResource StringToVisibility}}"/>

                    <Button Content="RESET PASSWORD"
                            Style="{StaticResource PrimaryButton}"
                            HorizontalAlignment="Stretch"
                            Margin="0,0,0,10"
                            Click="ResetButton_Click"/>

                    <Button Content="Back to unlock"
                            Style="{StaticResource GhostButton}"
                            HorizontalAlignment="Stretch"
                            Command="{Binding CancelCommand}"/>

                    <TextBlock Style="{StaticResource DangerText}"
                               Margin="0,16,0,0"
                               TextWrapping="Wrap"
                               Text="{Binding ErrorMessage}"
                               Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibility}}"/>
                </StackPanel>
            </ContentControl>
        </StackPanel>
    </Grid>
</UserControl>
