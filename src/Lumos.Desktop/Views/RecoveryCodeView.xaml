<UserControl x:Class="Lumos.Desktop.Views.RecoveryCodeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:Lumos.Desktop.Views"
             xmlns:conv="clr-namespace:Lumos.Desktop.Converters">
    <UserControl.Resources>
        <conv:StringToVisibilityConverter x:Key="StringToVisibility"/>
    </UserControl.Resources>

    <Grid>
        <views:CyberBackdrop/>

        <StackPanel VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Width="560">

            <TextBlock Text="LUMOS"
                       Style="{StaticResource DisplayHeading}"
                       FontSize="{StaticResource FontSize3xl}"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,4">
                <TextBlock.Effect>
                    <DropShadowEffect Color="{StaticResource AccentGoldShadowColor}"
                                      BlurRadius="16" ShadowDepth="0" Opacity="0.45"/>
                </TextBlock.Effect>
            </TextBlock>

            <TextBlock Text="// write this down"
                       Style="{StaticResource MonoLabel}"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,28"/>

            <ContentControl Style="{StaticResource NeonCard}">
                <StackPanel Margin="32,28">
                    <TextBlock Text="// RECOVERY"
                               Style="{StaticResource MonoLabel}"
                               Margin="0,0,0,4"/>
                    <TextBlock Text="{Binding Headline}"
                               Style="{StaticResource SectionHeading}"
                               Margin="0,0,0,6"/>
                    <TextBlock Style="{StaticResource SecondaryText}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,20"
                               Text="{Binding Explanation}"/>

                    <!-- The code itself: monospace, generously spaced, selectable
                         so the user can copy by hand if they prefer. -->
                    <Border BorderBrush="{StaticResource AccentGoldDimBrush}"
                            BorderThickness="1"
                            Background="{StaticResource BgDeepBrush}"
                            Padding="18,16"
                            Margin="0,0,0,16">
                        <TextBox Text="{Binding Code, Mode=OneWay}"
                                 IsReadOnly="True"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 Foreground="{StaticResource AccentGoldBrush}"
                                 FontFamily="{StaticResource MonoFontFamily}"
                                 FontSize="{StaticResource FontSizeLg}"
                                 TextAlignment="Center"
                                 TextWrapping="Wrap"
                                 IsTabStop="False"/>
                    </Border>

                    <!-- Actions -->
                    <Grid Margin="0,0,0,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0"
                                Content="COPY"
                                Style="{StaticResource SecondaryButton}"
                                HorizontalAlignment="Stretch"
                                Command="{Binding CopyCommand}"/>
                        <Button Grid.Column="2"
                                Content="SAVE TO FILE"
                                Style="{StaticResource SecondaryButton}"
                                HorizontalAlignment="Stretch"
                                Command="{Binding SaveCommand}"/>
                    </Grid>

                    <TextBlock Style="{StaticResource SecondaryText}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,16"
                               Text="{Binding StatusMessage}"
                               Visibility="{Binding StatusMessage, Converter={StaticResource StringToVisibility}}"/>

                    <!-- The honest warning. Deliberately unmissable: this is the
                         only screen where losing the code is still preventable. -->
                    <Border BorderBrush="{StaticResource WarningBrush}"
                            BorderThickness="0,0,0,0"
                            Background="Transparent"
                            Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SecondaryText}"
                                       Foreground="{StaticResource WarningBrush}"
                                       FontWeight="SemiBold"
                                       TextWrapping="Wrap"
                                       Text="This code is shown once and cannot be retrieved later."/>
                            <TextBlock Style="{StaticResource SecondaryText}"
                                       TextWrapping="Wrap"
                                       Margin="0,6,0,0"
                                       Text="Keep it somewhere separate from this computer — printed and filed, or in a safe. Nobody can recover your vault for you, including the Lumos authors. There is no server and no master key."/>
                        </StackPanel>
                    </Border>

                    <CheckBox Content="I have saved my recovery code somewhere safe"
                              Foreground="{StaticResource TextPrimaryBrush}"
                              FontFamily="{StaticResource BodyFontFamily}"
                              FontSize="{StaticResource FontSizeSm}"
                              Margin="0,0,0,18"
                              IsChecked="{Binding HasSaved, Mode=TwoWay}"/>

                    <Button Content="CONTINUE"
                            Style="{StaticResource PrimaryButton}"
                            HorizontalAlignment="Stretch"
                            Command="{Binding ContinueCommand}"/>
                </StackPanel>
            </ContentControl>
        </StackPanel>
    </Grid>
</UserControl>
