<UserControl x:Class="Lumos.Desktop.Views.RecoverySetupPromptView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:Lumos.Desktop.Views"
             xmlns:conv="clr-namespace:Lumos.Desktop.Converters">
    <UserControl.Resources>
        <conv:StringToVisibilityConverter x:Key="StringToVisibility"/>
    </UserControl.Resources>

    <Grid>
        <views:CyberBackdrop/>

        <StackPanel VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Width="540">

            <TextBlock Text="LUMOS"
                       Style="{StaticResource DisplayHeading}"
                       FontSize="{StaticResource FontSize3xl}"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,4">
                <TextBlock.Effect>
                    <DropShadowEffect Color="{StaticResource AccentGoldShadowColor}"
                                      BlurRadius="16" ShadowDepth="0" Opacity="0.45"/>
                </TextBlock.Effect>
            </TextBlock>

            <TextBlock Text="// something new"
                       Style="{StaticResource MonoLabel}"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,28"/>

            <ContentControl Style="{StaticResource NeonCard}">
                <StackPanel Margin="32,28">
                    <TextBlock Text="// RECOVERY"
                               Style="{StaticResource MonoLabel}"
                               Margin="0,0,0,4"/>
                    <TextBlock Text="Set up a recovery code"
                               Style="{StaticResource SectionHeading}"
                               Margin="0,0,0,6"/>

                    <TextBlock Style="{StaticResource SecondaryText}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,8"
                               Text="Until now, forgetting your master password meant losing your vault permanently. Lumos can now issue you a recovery code — a second, independent way in."/>
                    <TextBlock Style="{StaticResource SecondaryText}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,8"
                               Text="Your vault and your master password do not change. Nothing is re-encrypted, and nothing is sent anywhere — Lumos stays entirely offline."/>
                    <TextBlock Style="{StaticResource SecondaryText}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,20"
                               Text="Enter your master password to generate the code. Lumos needs it to unlock the vault key it is about to protect."/>

                    <TextBlock Text="MASTER PASSWORD" Style="{StaticResource MonoLabel}" Margin="0,0,0,6"/>
                    <views:RevealPasswordBox x:Name="PasswordField"
                                             Margin="0,0,0,18"
                                             PasswordKeyDown="PasswordField_KeyDown"/>

                    <Button Content="GENERATE RECOVERY CODE"
                            Style="{StaticResource PrimaryButton}"
                            HorizontalAlignment="Stretch"
                            Margin="0,0,0,10"
                            Click="SetUpButton_Click"/>

                    <Button Content="Not now — remind me next time"
                            Style="{StaticResource GhostButton}"
                            HorizontalAlignment="Stretch"
                            Command="{Binding DeferCommand}"/>

                    <TextBlock Style="{StaticResource DangerText}"
                               Margin="0,16,0,0"
                               TextWrapping="Wrap"
                               Text="{Binding ErrorMessage}"
                               Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibility}}"/>
                </StackPanel>
            </ContentControl>
        </StackPanel>
    </Grid>
</UserControl>
