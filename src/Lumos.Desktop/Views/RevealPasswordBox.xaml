<UserControl x:Class="Lumos.Desktop.Views.RevealPasswordBox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <!-- Masked and revealed fields are stacked, with exactly one visible at
             a time. WPF's PasswordBox has no plaintext mode and deliberately
             exposes no bindable Password property, so swapping in a TextBox is
             the only way to offer a reveal toggle. -->
        <PasswordBox x:Name="Masked"
                     Style="{StaticResource LumosPasswordBox}"
                     Padding="14,10,42,10"
                     PasswordChanged="Masked_PasswordChanged"
                     KeyDown="Field_KeyDown"/>

        <TextBox x:Name="Revealed"
                 Style="{StaticResource LumosTextBox}"
                 Padding="14,10,42,10"
                 FontFamily="{StaticResource MonoFontFamily}"
                 Visibility="Collapsed"
                 TextChanged="Revealed_TextChanged"
                 KeyDown="Field_KeyDown"/>

        <!-- Eye toggle, inset over the right edge of the field. -->
        <Button x:Name="ToggleButton"
                Width="34"
                Height="34"
                Margin="0,0,4,0"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Background="Transparent"
                BorderThickness="0"
                Cursor="Hand"
                Focusable="False"
                ToolTip="Show password"
                Click="ToggleButton_Click">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background"
                                    Value="{StaticResource SurfaceHoverBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Button.Template>
            <TextBlock x:Name="ToggleGlyph"
                       Text="&#xE7B3;"
                       FontFamily="Segoe MDL2 Assets"
                       FontSize="15"
                       Foreground="{StaticResource TextSecondaryBrush}"/>
        </Button>
    </Grid>
</UserControl>
